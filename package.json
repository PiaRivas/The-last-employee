{
  "name": "the-last-employee",
  "private": true,
  "version": "0.0.0",
  "description": "THE LAST EMPLOYEE — first-person action comedy: the last human worker vs. hordes of AI robots.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @tle/game --",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w @tle/game --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9"
  }
}
