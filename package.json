{
  "name": "the-last-employee",
  "private": true,
  "version": "0.0.0",
  "description": "THE LAST EMPLOYEE — first-person action comedy: the last human worker vs. hordes of AI robots.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/game dev",
    "sim": "bun run --cwd apps/game sim",
    "snap": "bun run --cwd apps/game snap",
    "test": "bun run --cwd apps/game test",
    "typecheck": "bun run --cwd apps/game typecheck",
    "build": "bun run --cwd apps/game build",
    "doctor": "bun run --cwd apps/game doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
